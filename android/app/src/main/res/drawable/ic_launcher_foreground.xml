<?xml version="1.0" encoding="utf-8"?>
<!-- The Vesper orb: soft cyan glow, bright core fading to violet. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- glow -->
    <path android:pathData="M54,20a34,34 0 1,0 0.01,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34"
                android:type="radial">
                <item android:color="#884FD1FF" android:offset="0.55" />
                <item android:color="#004FD1FF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- core -->
    <path android:pathData="M54,30a24,24 0 1,0 0.01,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="47"
                android:centerY="45"
                android:gradientRadius="34"
                android:type="radial">
                <item android:color="#FFE6FBFF" android:offset="0" />
                <item android:color="#FF4FD1FF" android:offset="0.45" />
                <item android:color="#FF7C5CFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- rim -->
    <path
        android:pathData="M54,30a24,24 0 1,0 0.01,0z"
        android:strokeWidth="1"
        android:strokeColor="#40FFFFFF" />
</vector>
